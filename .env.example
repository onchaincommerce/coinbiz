# Server-only Coinbase Business credentials
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Client-safe CDP Embedded Wallet project configuration
NEXT_PUBLIC_CDP_PROJECT_ID=
NEXT_PUBLIC_CDP_APP_NAME=Coinbiz
NEXT_PUBLIC_CDP_APP_LOGO_URL=

# Save these after creating webhook subscriptions for each environment
COINBASE_WEBHOOK_SANDBOX_SECRET=
COINBASE_WEBHOOK_LIVE_SECRET=

# Optional replay window override in minutes
COINBASE_WEBHOOK_MAX_AGE_MINUTES=5

# Headless agentic checkout payer
HEADLESS_PAYMENT_INTERNAL_TOKEN=
HEADLESS_CHECKOUT_PAYER_ENABLED=false
HEADLESS_CHECKOUT_PAYER_MAX_USDC=0.01
HEADLESS_CHECKOUT_PAYER_PRIVATE_KEY=

# Vercel Postgres webhook event storage
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
